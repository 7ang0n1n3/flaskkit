# Portainer Environment Variables for FlaskKit
# Copy these variables to Portainer Stack Environment Variables

# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
DB_PASSWORD=flaskkit123

# Optional: Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Optional: Custom Domain (if using nginx)
DOMAIN_NAME=your-domain.com
